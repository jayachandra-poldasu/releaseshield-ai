# ── ReleaseShield AI Configuration ────────────────────────────────────────────
# Copy this file to .env and update values as needed.

# AI Backend: "ollama" (default), "openai", or "none"
RELEASESHIELD_AI_BACKEND=ollama

# Ollama Settings (for local LLM inference)
RELEASESHIELD_OLLAMA_URL=http://localhost:11434/api/generate
RELEASESHIELD_OLLAMA_MODEL=llama3
RELEASESHIELD_OLLAMA_TIMEOUT=120

# OpenAI Settings (if using OpenAI backend)
RELEASESHIELD_OPENAI_API_KEY=
RELEASESHIELD_OPENAI_MODEL=gpt-4o-mini
RELEASESHIELD_OPENAI_TIMEOUT=60

# Data Directory
RELEASESHIELD_DATA_DIR=./data

# Debug Mode
RELEASESHIELD_DEBUG=false
